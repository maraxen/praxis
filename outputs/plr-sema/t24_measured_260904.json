        "amount_param": "vols",
        "caller_lineno": null,
        "caller_scope": null,
        "cell_param": {
          "local": true,
          "name": "tips"
        },
        "condition": "volume - self.get_free_volume() > 1e-06",
        "direction": "increasing",
        "for_span": [
          1031,
          1035
        ],
        "free_vars": [
          "self",
          "volume"
        ],
        "kind": "raise_guard",
        "raises": "TooLittleVolumeError",
        "scope_trail": [
          "if volume - self.get_free_volume() > 1e-06"
        ],
        "site": {
          "file": "external/pylabrobot/pylabrobot/resources/volume_tracker.py",
