  "bridged_volume_guards": {
    "LiquidHandler.aspirate": [
      {
        "amount_param": "vols",
        "caller_lineno": null,
        "caller_scope": null,
        "cell_param": "resources",
        "condition": "volume - self.get_used_volume() > 1e-06",
        "direction": "decreasing",
        "for_span": [
          1031,
          1035
        ],
        "free_vars": [
          "self",
          "volume"
        ],
        "kind": "raise_guard",
        "raises": "TooLittleLiquidError",
        "scope_trail": [
          "if volume - self.get_used_volume() > 1e-06"
        ],
        "site": {
          "file": "external/pylabrobot/pylabrobot/resources/volume_tracker.py",
          "lineno": 92,
          "qualname": "VolumeTracker.remove_liquid"
        },
        "via": "op.resource.tracker.remove_liquid"
      },
