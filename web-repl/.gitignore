# Generated build tree.
/dist/

# Vendored Pyodide bundle (fetched by scripts/fetch_pyodide.py).
/vendor/

# Wheels are built by scripts/build_wheels.py, not committed.
/overlay/assets/wheels/

# Defensive negation (ADR .praxia/docs/decisions/260817_repl-layout-and-delivery-mechanism.md
# §5.4, "gitignore"): the vendored visualizer renderer under overlay/assets/visualizer/
# is COMMITTED, not generated. A bare `dist/` pattern above matches at any depth, so
# a renderer that itself contains a `dist/` subdirectory would otherwise be silently
# swallowed and the page would ship broken with no diff to notice. This negation must
# survive; verify with (NOTE: -v itself exits 0 on ANY matching pattern, negation
# included -- git 2.43 confirmed; use the non-verbose form, or `git status --porcelain`,
# to check the FINAL ignored/not-ignored outcome):
#   git check-ignore web-repl/overlay/assets/visualizer/lib.js   # must exit 1 (not ignored), on a file that exists
!/overlay/assets/visualizer/**

# FunctionGemma model binaries (P2.7a): fetched by scripts/fetch_models.py
# --models, never committed (F3 / zero-tracked-binaries). The explicit child
# pattern documents the contract even though /vendor/ above already covers it.
/vendor/models/

# ORT WebAssembly backend binary under the vendored transformers.js tree
# (P2.7a): fetched by scripts/fetch_models.py --runtime into the TRACKED
# overlay/assets/coxswain/vendor/ tree, but a compiled binary -> gitignored.
# Its expected sha256 is pinned in that dir's VENDOR_MANIFEST.json; the JS
# siblings of this pattern ARE tracked.
/overlay/assets/coxswain/vendor/ort/*.wasm
